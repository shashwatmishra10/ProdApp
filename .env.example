# Copy this file to .env and fill in real values before enabling live integrations.
# Every value below has a safe fallback in code, so the app runs in demo mode with none of this set.

# --- Core ---
# Prisma resolves a relative sqlite path against prisma/schema.prisma's own
# folder, so "./dev.db" here means prisma/dev.db on disk (not ./dev.db from cwd).
# In production on a host with an ephemeral filesystem (Railway, Render, etc.),
# attach a persistent volume and point this at an absolute path on it instead,
# e.g. DATABASE_URL="file:/data/prod.db" — otherwise the database is wiped on
# every redeploy/restart.
DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=4000
NODE_ENV=development

# --- Bank Account Aggregator (Setu AA sandbox: https://docs.setu.co/data/account-aggregator) ---
# Leave blank to use the built-in mock AA provider (clearly labeled as simulated data).
AA_PROVIDER=mock          # "setu" to use the real Setu AA client, "mock" for simulated data
AA_CLIENT_ID=
AA_CLIENT_SECRET=
AA_BASE_URL=https://fiu-sandbox.setu.co
AA_REDIRECT_URL=http://localhost:4000/api/integrations/aa/callback

# --- Gmail receipt capture (Google Cloud OAuth client: https://console.cloud.google.com/apis/credentials) ---
# Leave blank to disable and keep the Gmail connector in "Not connected" state.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:4000/api/integrations/gmail/callback

# --- Email export ("Email me a copy" on the Transactions screen) ---
# Leave blank to disable; the app falls back to downloading the CSV instead.
# Any standard SMTP account works (Gmail app password, SendGrid/Mailgun/etc. SMTP relay).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Minto <no-reply@minto.app>"
